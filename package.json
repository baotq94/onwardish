{
    "name": "new-blog",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "resetorm": "prisma generate",
        "initdb": "prisma db push",
        "generate:content": "node scripts/generate-content-index.mjs",
        "dev": "npm run generate:content && next dev --webpack --hostname 0.0.0.0",
